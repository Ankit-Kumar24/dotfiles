animations {
    workspace-switch {
        spring damping-ratio=0.85 stiffness=1000 epsilon=0.0001
    }
    window-open {
        duration-ms 100
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 100
        curve "ease-out-expo"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=900 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.75 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-expo"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=900 epsilon=0.0001
    }
}
