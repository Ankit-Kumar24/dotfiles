layout {
    gaps 3.8

    focus-ring {
        off
    }
    // Widths that Mod+R cycles through.
    preset-column-widths {
        proportion 0.5
        proportion 0.33333
	    proportion 1.0
    }

    // Width new windows open at.
    default-column-width { proportion 1.0; }

    shadow {
        on
        softness 30
        spread 5 
        offset x=0 y=2
        color "#00000070"
        draw-behind-window true
    }
    insert-hint {
        on
    }
}
