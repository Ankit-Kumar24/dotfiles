input {
    keyboard {
        xkb {
		options "ctrl:swapcaps"
        }
	repeat-delay 300
        numlock
    }

    touchpad {
        tap                
        natural-scroll    
	accel-speed 0.2
        dwt             
    }

    mouse {
        accel-profile "flat"   
    }

    warp-mouse-to-focus
}
