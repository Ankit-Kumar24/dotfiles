binds {
    // === === System and Sessions === ===
    Mod+Shift+Slash                                    { show-hotkey-overlay; }
    Mod+Alt+L hotkey-overlay-title="Lock the Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q hotkey-overlay-title="Session Menu"    { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Escape  allow-inhibiting=false                 { toggle-keyboard-shortcuts-inhibit; }
    
    // === === Launchers and Apps === ===
    Mod+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Space  hotkey-overlay-title="Application launcher"   { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B      hotkey-overlay-title="Open browser"           { spawn "helium-browser"; }
    Mod+E      hotkey-overlay-title="Open file explorer"     { spawn "nautilus"; }
    Mod+S      hotkey-overlay-title="Launch spotify"         { spawn "spotify"; }

    // === === Shell Panels === === 
    Mod+Ctrl+W hotkey-overlay-title="Wallpaper selector" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Comma  hotkey-overlay-title="Noctalia settings"  { spawn-sh "noctalia msg settings-toggle"; }
    
    // === === Media and Hardware Keys === ===
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    
    // === === Spotify === ===
    Mod+Alt+Space    hotkey-overlay-title=null  allow-when-locked=true { spawn-sh "playerctl -p spotify play-pause"; }
    Mod+Alt+Up       hotkey-overlay-title=null  allow-when-locked=true { spawn-sh "playerctl -p spotify volume 0.05+"; }
    Mod+Alt+Down     hotkey-overlay-title=null  allow-when-locked=true { spawn-sh "playerctl -p spotify volume 0.05-"; }
    Mod+Alt+Comma    hotkey-overlay-title=null  allow-when-locked=true { spawn-sh "playerctl -p spotify previous"; }
    Mod+Alt+Period   hotkey-overlay-title=null  allow-when-locked=true { spawn-sh "playerctl -p spotify next"; }
    
    // === === Screenshots === ===
    Print       hotkey-overlay-title="Screenshot" { screenshot; }
    Mod+Shift+S hotkey-overlay-title=null         { screenshot; }
    Ctrl+Print  hotkey-overlay-title=null         { screenshot-screen; }
    Alt+Print   hotkey-overlay-title=null         { screenshot-window; }
    
    // === === Focus (windows & columns) === ===
    Mod+H    hotkey-overlay-title=null     { focus-column-left; }
    Mod+J    hotkey-overlay-title=null     { focus-window-or-workspace-down; }
    Mod+K    hotkey-overlay-title=null     { focus-window-or-workspace-up; }
    Mod+L    hotkey-overlay-title=null     { focus-column-right; }
    Mod+Home hotkey-overlay-title=null     { focus-column-first; }
    Mod+End  hotkey-overlay-title=null     { focus-column-last; }

    // === === Move (windows & columns) === ===

    Mod+Ctrl+H  hotkey-overlay-title=null  { move-column-left; }
    Mod+Ctrl+J  hotkey-overlay-title=null  { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K  hotkey-overlay-title=null  { move-window-up-or-to-workspace-up; }
    Mod+Ctrl+L  hotkey-overlay-title=null  { move-column-right; }

    // === === Monitors === ===

    // Mod+Shift+H     { focus-monitor-left; }
    // Mod+Shift+J     { focus-monitor-down; }
    // Mod+Shift+K     { focus-monitor-up; }
    // Mod+Shift+L     { focus-monitor-right; }
    //
    // Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    // Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    // Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    // Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    
    // === === Workspaces === ===
    Mod+O         repeat=false hotkey-overlay-title="Overview"           { toggle-overview; }
    Mod+Tab                    hotkey-overlay-title="Previous workspace" { focus-workspace-previous; }

    Mod+Page_Down      hotkey-overlay-title=null  { focus-workspace-down; }
    Mod+Page_Up        hotkey-overlay-title=null  { focus-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-up; }
    Mod+Shift+I         { move-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown hotkey-overlay-title=null  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   hotkey-overlay-title=null  cooldown-ms=150 { move-column-to-workspace-up; }

    // === === Layout & Sizing === === 

    Mod+Backspace repeat=false hotkey-overlay-title="Close window"       { close-window; }

    // Columns: Stack / unstack / tabs
    Mod+BracketLeft   hotkey-overlay-title=null  { consume-or-expel-window-left; }
    Mod+BracketRight  hotkey-overlay-title=null  { consume-or-expel-window-right; }
    Mod+W       { toggle-column-tabbed-display; }
    
    // Sizing
    Mod+R  hotkey-overlay-title=null  { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    
    // Maximize / fullscreen
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    
    // Floating
    Mod+V       hotkey-overlay-title="Toggle floating"              { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Switch focus floating/tiling" { switch-focus-between-floating-and-tiling; }

}
